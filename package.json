{
  "name": "do-knowledge-studio",
  "private": true,
  "version": "0.2.5",
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "esbuild@<0.28.1": "~0.28.1",
      "ws@<8.21.0": "~8.21.0",
      "dompurify": "3.4.11",
      "protobufjs@<7.6.3": "~7.6.3",
      "vite@<8.0.16": "~8.0.16"
    }
  },
  "description": "Local-first knowledge studio — rich text, knowledge graph, mind maps, SQLite WASM FTS5 search, Orama RAG & AI agent harness. No backend required.",
  "keywords": [
    "local-first",
    "react",
    "typescript",
    "vite",
    "sqlite-wasm",
    "fts5",
    "full-text-search",
    "orama",
    "tiptap",
    "knowledge-graph",
    "mind-map",
    "sigma-js",
    "ai-agents",
    "triz"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "node --max-old-space-size=4096 node_modules/vitest/vitest.mjs run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ci": "pnpm run build && PLAYWRIGHT_MODE=production playwright test",
    "typecheck": "tsc --noEmit",
    "cli": "node --import tsx/esm cli/index.ts",
    "design:validate": "node scripts/design/validate-tokens.mjs",
    "design:colors": "node scripts/design/check-hardcoded-colors.mjs",
    "design:aria": "node scripts/design/check-aria.mjs",
    "design:check": "pnpm run design:validate && pnpm run design:colors && pnpm run design:aria",
    "quality_gate": "pnpm run design:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@orama/orama": "~3.1.18",
    "@orama/plugin-embeddings": "~3.1.18",
    "@react-pdf/renderer": "~4.5.1",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@tanstack/react-virtual": "~3.14.5",
    "@tiptap/core": "3.27.1",
    "@tiptap/extension-placeholder": "~3.27.1",
    "@tiptap/pm": "~3.27.1",
    "@tiptap/react": "~3.27.1",
    "@tiptap/starter-kit": "~3.27.1",
    "commander": "~15.0.0",
    "docx": "~9.7.1",
    "dompurify": "3.4.11",
    "graphology": "~0.26.0",
    "graphology-layout-forceatlas2": "~0.10.1",
    "jszip": "~3.10.1",
    "lucide-react": "~1.23.0",
    "mind-elixir": "~5.13.0",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "~7.18.1",
    "sigma": "~3.0.0-beta.27",
    "zod": "~4.4.3",
    "zustand": "~5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "~1.61.1",
    "@testing-library/dom": "~10.4.1",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "~16.3.2",
    "@testing-library/user-event": "~14.6.1",
    "@types/better-sqlite3": "~7.6.13",
    "@types/jsdom": "~28.0.3",
    "@types/node": "~26.1.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "~6.0.3",
    "@vitest/coverage-v8": "~4.1.9",
    "better-sqlite3": "~12.11.1",
    "eslint": "~9.39.4",
    "eslint-plugin-jsx-a11y": "~6.10.2",
    "eslint-plugin-react": "~7.37.5",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "~0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "~17.7.0",
    "graphology-types": "~0.24.8",
    "happy-dom": "~20.10.6",
    "jsdom": "~29.1.1",
    "picomatch": "~4.0.5",
    "rollup-plugin-visualizer": "~7.0.1",
    "ts-node": "~10.9.2",
    "tslib": "~2.8.1",
    "tsx": "~4.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.62.1",
    "vite": "~8.1.3",
    "vitest": "~4.1.9"
  }
}
