#!/usr/bin/env bash
# Regression coverage for manifest-generated instruction and labeler surfaces.

bats_require_minimum_version 1.5.0

setup() {
  export SCRIPT_DIR="$BATS_TEST_DIRNAME/../scripts"
  export WORK="$BATS_TEST_TMPDIR/workspace"
  mkdir -p "$WORK/.agents/skills" "$WORK/.agents/instructions" "$WORK/.github" "$WORK/scripts"
  cp "$SCRIPT_DIR/agent-surface.py" "$WORK/scripts/agent-surface.py"
  cp "$SCRIPT_DIR/agent_surface_generated.py" "$WORK/scripts/agent_surface_generated.py"
  cp "$SCRIPT_DIR/generate-skills-docs.py" "$WORK/scripts/generate-skills-docs.py"
}

write_fixture() {
  mkdir -p "$WORK/.agents/skills/fixture-skill"
  cat > "$WORK/.agents/manifest.json" <<'EOF'
{
  "version": "1.0.0",
  "canonical_instructions": "AGENTS.md",
  "canonical_skills": ".agents/skills",
  "skill_labeler": ".github/labeler.yml",
  "tools": {
    "claude": {
      "directory": ".claude",
      "skills_directory": ".claude/skills",
      "docs": ["CLAUDE.md"],
      "instruction_addendum": ".agents/instructions/claude.md",
      "symlink_strategy": "relative-entries"
    },
    "gemini": {
      "directory": ".gemini",
      "skills_directory": ".gemini/skills",
      "docs": ["GEMINI.md"],
      "symlink_strategy": "relative-entries"
    },
    "qwen": {
      "directory": ".qwen",
      "skills_directory": ".qwen/skills",
      "docs": ["QWEN.md"],
      "symlink_strategy": "relative-entries"
    },
    "cursor": {
      "directory": ".cursor",
      "skills_directory": ".cursor/skills",
      "symlink_strategy": "relative-directory"
    },
    "windsurf": {
      "directory": ".windsurf",
      "skills_directory": ".windsurf/skills",
      "symlink_strategy": "relative-directory"
    }
  }
}
EOF
  printf '# Canonical instructions\n' > "$WORK/AGENTS.md"
  printf '## Claude-only notes\n\nKeep these distinct.\n' > "$WORK/.agents/instructions/claude.md"
  cat > "$WORK/.github/labeler.yml" <<'EOF'
# Documentation changes
# BEGIN GENERATED SKILLS LABELS
skills:
  - changed-files:
      - any-glob-to-any-file: []
# END GENERATED SKILLS LABELS

# Script changes
scripts:
  - changed-files:
      - any-glob-to-any-file:
          - 'scripts/**/*'
EOF
}

prepare_validation_fixture() {
  write_fixture
  cat > "$WORK/.agents/skills/fixture-skill/SKILL.md" <<'EOF'
---
name: fixture-skill
description: Temporary skill for exercising validation in an isolated workspace.
---
# Fixture skill

This body keeps the fixture complete for the command-line validator.
[Missing target](missing.md)
EOF
  mkdir -p "$WORK/agents-docs"
  run python3 "$WORK/scripts/generate-skills-docs.py" --root "$WORK"
  [ "$status" -eq 0 ]
  run python3 "$WORK/scripts/agent-surface.py" sync
  [ "$status" -eq 0 ]
}

@test "sync generates root instructions and manifest-derived labeler globs idempotently" {
  write_fixture
  run python3 "$WORK/scripts/agent-surface.py" sync
  [ "$status" -eq 0 ]
  grep -q '^<!-- Generated by ' "$WORK/CLAUDE.md"
  grep -q '^# Canonical instructions$' "$WORK/CLAUDE.md"
  grep -q '^## Claude-only notes$' "$WORK/CLAUDE.md"
  grep -q '^<!-- Generated by ' "$WORK/GEMINI.md"
  grep -q '^# Canonical instructions$' "$WORK/GEMINI.md"
  [ -L "$WORK/.claude/skills/fixture-skill" ]
  grep -q "'\.agents/skills/\*\*/\*'" "$WORK/.github/labeler.yml"
  grep -q "'\.cursor/skills/\*\*/\*'" "$WORK/.github/labeler.yml"
  grep -q "'\.windsurf/skills/\*\*/\*'" "$WORK/.github/labeler.yml"

  cp "$WORK/CLAUDE.md" "$BATS_TEST_TMPDIR/CLAUDE.md"
  cp "$WORK/GEMINI.md" "$BATS_TEST_TMPDIR/GEMINI.md"
  cp "$WORK/QWEN.md" "$BATS_TEST_TMPDIR/QWEN.md"
  cp "$WORK/.github/labeler.yml" "$BATS_TEST_TMPDIR/labeler.yml"
  run python3 "$WORK/scripts/agent-surface.py" sync
  [ "$status" -eq 0 ]
  diff "$BATS_TEST_TMPDIR/CLAUDE.md" "$WORK/CLAUDE.md"
  diff "$BATS_TEST_TMPDIR/GEMINI.md" "$WORK/GEMINI.md"
  diff "$BATS_TEST_TMPDIR/QWEN.md" "$WORK/QWEN.md"
  diff "$BATS_TEST_TMPDIR/labeler.yml" "$WORK/.github/labeler.yml"
}

@test "generated-surface validation reports root instruction and labeler drift" {
  write_fixture
  run python3 "$WORK/scripts/agent-surface.py" sync
  [ "$status" -eq 0 ]
  run python3 - "$SCRIPT_DIR" "$WORK" <<'PY'
import json
import sys
from pathlib import Path

sys.path.insert(0, sys.argv[1])
from agent_surface_generated import validate_generated_surfaces

root = Path(sys.argv[2])
manifest = json.loads((root / ".agents/manifest.json").read_text(encoding="utf-8"))
(root / "GEMINI.md").write_text("drift\n", encoding="utf-8")
errors = validate_generated_surfaces(root, manifest)
assert any("GEMINI.md" in error for error in errors), errors

PY
  [ "$status" -eq 0 ]
}

@test "generated-surface validation rejects labeler drift" {
  write_fixture
  run python3 "$WORK/scripts/agent-surface.py" sync
  [ "$status" -eq 0 ]
  run python3 - "$SCRIPT_DIR" "$WORK" <<'PY'
import json
import sys
from pathlib import Path

sys.path.insert(0, sys.argv[1])
from agent_surface_generated import validate_generated_surfaces

root = Path(sys.argv[2])
manifest = json.loads((root / ".agents/manifest.json").read_text(encoding="utf-8"))
labeler = root / ".github/labeler.yml"
labeler.write_text(labeler.read_text(encoding="utf-8").replace(".cursor/skills/**/*", ".cursor/other/**/*"), encoding="utf-8")
errors = validate_generated_surfaces(root, manifest)
assert any("labeler.yml" in error for error in errors), errors
PY
  [ "$status" -eq 0 ]
}

@test "validate preserves broken skill-link and canonical-instruction checks" {
  prepare_validation_fixture
  run python3 "$WORK/scripts/agent-surface.py" validate
  [ "$status" -eq 1 ]
  [[ "$output" == *"broken link 'missing.md'"* ]]
  [[ "$output" == *"AGENTS.md missing section: ## Project"* ]]
}

@test "skill-link sync rejects paths outside the repository" {
  run python3 - "$SCRIPT_DIR" "$WORK" <<'PY'
import importlib.util
import sys
from pathlib import Path

scripts = Path(sys.argv[1])
sys.path.insert(0, str(scripts))
spec = importlib.util.spec_from_file_location("agent_surface", scripts / "agent-surface.py")
assert spec is not None and spec.loader is not None
agent_surface = importlib.util.module_from_spec(spec)
spec.loader.exec_module(agent_surface)

root = Path(sys.argv[2])
manifest = {
    "canonical_skills": ".agents/skills",
    "tools": {
        "fixture": {
            "directory": ".fixture",
            "skills_directory": "../outside",
            "symlink_strategy": "relative-directory",
        }
    },
}
errors = agent_surface.check_managed_skill_links(root, manifest, repair=True)
assert not (root.parent / "outside").exists()
assert any("must stay inside the repository" in error for error in errors), errors
PY
  [ "$status" -eq 0 ]
}
