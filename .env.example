 # Optional comma-separated WebRTC signaling server URLs for Yjs collaboration.
 # Defaults to the installed y-webrtc provider's signaling endpoint when unset.
 NEXT_PUBLIC_YJS_SIGNALING_SERVERS=wss://y-webrtc-eu.fly.dev

 # Optional JSON array of ICE servers for peer-to-peer sync, e.g.
 # [{"urls":["stun:stun.example.com:3478"]},{"urls":["turns:relay.example.com:5349"],"username":"user","credential":"secret"}]
 # TURN credentials configured here are deployment defaults; users can add
 # their own in Sync settings, where they are stored encrypted.
 NEXT_PUBLIC_ICE_SERVERS=
