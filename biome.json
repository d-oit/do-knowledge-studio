{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": ["dist/**", "node_modules/**", "coverage/**", ".next/**", "**/*.test.*", "**/*.spec.*"]
  },
  "linter": {
    "rules": {
      "correctness": {
        "useExhaustiveDependencies": "off",
        "useHookAtTopLevel": "off"
      },
      "suspicious": {
        "noExplicitAny": "off"
      },
      "a11y": {
        "useButtonType": "off",
        "useValidLabel": "off",
        "noAutofocus": "off"
      },
      "security": {
        "noNoninteractiveElementInteractions": "off"
      }
    }
  }
}
