{
  "$schema": "https://mimo.xiaomi.com/mimocode/config.json",
  "model": "xiaomi/mimo-v2.5",
  "provider": {},
  "permission": {
    "edit": {
      "packages/opencode/migration/*": "deny"
    }
  },
  "mcp": {},
  "model_groups": {
    "lite": "cline-pass/cline-pass/deepseek-v4-flash",
    "standard": "xiaomi/mimo-v2.5",
    "ultra": "cline-pass/cline-pass/mimo-v2.5-pro"
  },
  "agent": {
    "build": {
      "model": "standard",
      "fallbacks": ["lite", "ultra"]
    },
    "explore": { "model": "lite" },
    "research": {
      "model": "ultra",
      "fallbacks": ["standard"]
    },
    "design": { "model": "cline-pass/cline-pass/kimi-k3" },
    "reviewer": {
      "model": "ultra",
      "fallbacks": ["standard"]
    },
    "vision": { "model": "lite" }
  },
  "plugin": ["opencode-rate-limit-fallback"]
}
