#!/usr/bin/env bash
# Pre-commit hook: runs quality gate in fast mode on staged files only.
# Exits non-zero to prevent commit if checks fail.
set +e
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT" || exit 1

# Colors for output
if [[ -t 1 ]] && [[ "${FORCE_COLOR:-}" != "0" ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    NC='\033[0m'
else
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    NC=''
fi

echo -e "${BLUE}========================================${NC}"
echo -e "${BLUE}  Pre-commit Quality Gate${NC}"
echo -e "${BLUE}========================================${NC}"
echo ""

# Detect staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || echo "")

if [ -z "$STAGED_FILES" ]; then
    echo -e "${YELLOW}No staged files to check. Skipping.${NC}"
    exit 0
fi

echo -e "${BLUE}Checking ${#STAGED_FILES} staged file(s)...${NC}"
echo ""

# Run quality gate in fast mode on changed files only
# Skip global hooks check since we are already running as a hook
export SKIP_GLOBAL_HOOKS_CHECK=true

if ./scripts/quality_gate.sh --fast --changed; then
    echo ""
    echo -e "${GREEN}========================================${NC}"
    echo -e "${GREEN}  Pre-commit checks passed${NC}"
    echo -e "${GREEN}========================================${NC}"
    exit 0
else
    EXIT_CODE=$?
    echo ""
    echo -e "${RED}========================================${NC}"
    echo -e "${RED}  Pre-commit checks failed${NC}"
    echo -e "${RED}========================================${NC}"
    echo ""
    echo -e "${RED}Fix the issues above and try again.${NC}"
    echo -e "${YELLOW}Hint: Run './scripts/quality_gate.sh --fast' locally to see all issues.${NC}"
    exit "$EXIT_CODE"
fi
